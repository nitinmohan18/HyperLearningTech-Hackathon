{
  "name": "hyperlearningtech-winter-hackathon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env PRISMA_ENV=production prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "cross-env PRISMA_ENV=production prisma generate",
    "db:generate:dev": "cross-env PRISMA_ENV=development prisma generate",
    "db:status:dev": "cross-env PRISMA_ENV=development prisma migrate status",
    "db:migrate:dev": "cross-env PRISMA_ENV=development prisma migrate dev",
    "db:generate:prod": "cross-env PRISMA_ENV=production prisma generate",
    "db:status:prod": "cross-env PRISMA_ENV=production prisma migrate status",
    "db:migrate:deploy:prod": "cross-env PRISMA_ENV=production prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/imagesloaded": "^4.1.7",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.10",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "imagesloaded": "^5.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "resend": "^6.39.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
