# Database (Neon PostgreSQL)
# Application runtime uses DATABASE_URL (pooled). Prisma CLI migrations use DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"
EXPECTED_DATABASE_HOST="ep-branch-name.region.aws.neon.tech"

# Email Delivery (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HyperLearningTech <registrations@mail.hyperlearningtech.in>"
EMAIL_REPLY_TO="hyperlearningtech@gmail.com"
OWNER_EMAIL="hyperlearningtech@gmail.com"

# Proposal Storage (Backblaze B2 - S3 Compatible)
# 1. B2_APPLICATION_KEY_ID: Backblaze "keyID" (from App Keys page)
# 2. B2_APPLICATION_KEY: Backblaze "applicationKey" (from App Keys page)
# 3. B2_BUCKET_NAME: Private bucket name in Backblaze B2
# 4. B2_REGION: Region where bucket was created (e.g. us-east-005, us-west-004)
# 5. B2_ENDPOINT: Backblaze S3 endpoint (e.g. https://s3.us-east-005.backblazeb2.com)
B2_APPLICATION_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_REGION="us-east-005"
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"

# Master Admin Authentication
ADMIN_SECRET=""
ADMIN_SESSION_SECRET=""

# Cron Job Secret (for /api/cron/process-emails)
CRON_SECRET=""

# Application Host URL
APP_URL="https://hackathon.hyperlearningtech.in"

# Cloudflare Turnstile (Optional)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# GitHub Inspection Account (Optional)
GITHUB_EVENT_USERNAME=""
